        "jsCode": "// Prepara a chamada da RPC fn_upsert_pedido. O payload vai CRU — o mapeamento é no SQL.\n// NÃO renomear o node 'Normalizar evento' — a referência abaixo é pelo nome.\nconst ev = $('Normalizar evento').first().json;\nconst p = $input.first().json?.retorno?.pedido;\nif (!p || !p.numero) return [];\nreturn [{ json: {\n  p,\n  p_tipo: ev.tipo || 'webhook',\n  p_tiny_id: Number(ev.id) || Number(p.id) || null,\n  p_origem: 'webhook',\n}}];"
      },
      "id": "b2000000-0000-0000-0000-000000000001",
      "name": "Montar payload Supabase",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [0, 260]
    },
    {
