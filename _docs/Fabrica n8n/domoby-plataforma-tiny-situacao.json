    {
      "id": "15917607-e3f4-4a98-a4f9-7f2ed6d7d8ca",
      "name": "Validar pedido",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ],
      "parameters": {
        "jsCode": "// O banco da plataforma chama aqui quando o Tiny precisa mudar a situação do pedido\n// (D-113): \"entregue\" quando a entrega é registrada; a situação de antes quando é desfeita.\nconst PERMITIDAS = ['aberto', 'aprovado', 'preparando_envio', 'faturado', 'pronto_envio', 'enviado', 'entregue', 'nao_entregue'];\nconst out = [];\nfor (const item of $input.all()) {\n  const b = item.json.body ?? item.json;\n  const situacao = String(b.situacao ?? '').trim();\n  if (!b.pedido_id || !b.numero || !PERMITIDAS.includes(situacao)) continue; // pedido malformado: ignora\n  out.push({ json: { pedido_id: Number(b.pedido_id), numero: String(b.numero), tiny_id: b.tiny_id ? String(b.tiny_id) : null,\n                     situacao, versao: Number(b.versao ?? 0) } });\n}\nreturn out;"
      }
    },
    {
      "id": "a346123a-d50e-4d81-831a-ca4dfe643ad2",
      "name": "Tem o id do Tiny?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        660,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 1
          },
          "conditions": [
            {
              "leftValue": "={{ $json.tiny_id }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.tiny.com.br/api2/pedidos.pesquisa.php",
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "token",
              "value": "={{ $env.TINY_TOKEN }}"
            },
            {
