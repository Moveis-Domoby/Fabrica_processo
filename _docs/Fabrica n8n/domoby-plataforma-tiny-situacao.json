    {
      "id": "5c549118-88c6-4ec1-8a9b-a2f66f6e534d",
      "name": "Montar resposta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        300
      ],
      "parameters": {
        "jsCode": "const alvo = $('Validar pedido').first().json;\nconst j = $input.first().json ?? {};\nconst ret = j.retorno ?? {};\nconst ok = ret.status === 'OK';\nconst erro = ok ? null : (j.erro ?? JSON.stringify(ret.erros ?? ret.codigo_erro ?? j.error ?? j.message ?? 'Tiny sem resposta')).slice(0, 400);\nreturn [{ json: { p_pedido_id: alvo.pedido_id, p_versao: alvo.versao, p_ok: ok, p_erro: erro } }];"
      }
    },
    {
      "id": "852ec7e7-777f-4a48-a897-9ca93301bff3",
