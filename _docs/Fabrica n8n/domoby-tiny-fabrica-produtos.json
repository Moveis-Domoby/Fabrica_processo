    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Pesquisa produtos no Tiny da FÁBRICA, TODAS as páginas (100 por página).\n// Entrada: itens com { origem, situacao?, dataCriacao? } (dos nodes 'Parâmetros').\n// Saída: um item por produto { tiny_id, origem }.\n// 'Consulta sem registros' (codigo_erro 20) = janela vazia, fim normal de ciclo.\n// ATENÇÃO (erro real em 21/09): o Code node roda em sandbox e NÃO expõe\n// URLSearchParams nem temporizador. O corpo é montado à mão e não há pausa —\n// são poucas requisições (≤ ~10 por execução). O ritmo pesado fica no node\n// produto.obter, que usa o batching do HTTP Request.\nconst URL_PESQUISA = 'https://api.tiny.com.br/api2/produtos.pesquisa.php';\nconst TOKEN = $env.TINY_FABRICA_TOKEN;\nif (!TOKEN) throw new Error('Falta a variável TINY_FABRICA_TOKEN no compose do n8n.');\n\nconst corpo = (obj) =>\n  Object.keys(obj)\n    .filter((k) => obj[k] !== undefined && obj[k] !== null && obj[k] !== '')\n    .map((k) => encodeURIComponent(k) + '=' + encodeURIComponent(obj[k]))\n    .join('&');\n\nconst saida = [];\nfor (const entrada of $input.all()) {\n  const q = entrada.json;\n  let pagina = 1, total = 1;\n  do {\n    const txt = await this.helpers.httpRequest({\n      method: 'POST', url: URL_PESQUISA, json: false, timeout: 30000,\n      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },\n      body: corpo({ token: TOKEN, formato: 'JSON', pesquisa: '', pagina: String(pagina), situacao: q.situacao, dataCriacao: q.dataCriacao }),\n    });\n    const ret = (typeof txt === 'string' ? JSON.parse(txt) : txt)?.retorno ?? {};\n    if (ret.status !== 'OK') {\n      if (Number(ret.codigo_erro) === 20) break; // nenhum produto nessa janela\n      throw new Error('produtos.pesquisa (fábrica) falhou na página ' + pagina + ': ' + JSON.stringify(ret.erros ?? ret));\n    }\n    total = Number(ret.numero_paginas ?? 1) || 1;\n    for (const x of ret.produtos ?? []) {\n      const pr = x.produto ?? x;\n      const id = Number(pr.id);\n      if (id) saida.push({ json: { tiny_id: id, origem: q.origem } });\n    }\n    pagina++;\n  } while (pagina <= total);\n}\n\n// Varredura: inclui os FILHOS de variação (a pesquisa lista só o pai).\n// Lê os ids em produtos.raw->variacoes dos pais já gravados.\nif ($input.all().some((e) => e.json.origem === 'varredura')) {\n  const base = $env.SUPABASE_FABRICA_URL, chave = $env.SUPABASE_FABRICA_KEY;\n  const pais = await this.helpers.httpRequest({\n    method: 'GET', url: base + '/rest/v1/produtos?tipo_variacao=eq.P&select=variacoes:raw->variacoes',\n    headers: { apikey: chave, Authorization: 'Bearer ' + chave }, json: true, timeout: 20000,\n  });\n  for (const pai of pais ?? []) {\n    for (const v of Array.isArray(pai.variacoes) ? pai.variacoes : []) {\n      const id = Number((v.variacao ?? v).id);\n      if (id) saida.push({ json: { tiny_id: id, origem: 'varredura' } });\n    }\n  }\n}\nreturn saida;"
      },
