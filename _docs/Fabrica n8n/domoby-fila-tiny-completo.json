    {
      "id": "927fe738-d9c9-4431-a6e3-4f5ffb101350",
      "name": "Achar o id pelo número",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        1120
      ],
      "parameters": {
        "jsCode": "// Sem o id interno: acha pelo número (o mesmo jeito do fluxo do ClickUp). NÃO renomear 'Validar pedido'.\nconst alvo = $('Validar pedido').first().json;\nconst ret = $input.first().json?.retorno ?? {};\nconst lista = Array.isArray(ret.pedidos) ? ret.pedidos : (ret.pedidos ? [ret.pedidos] : []);\nconst p = lista.map((x) => x.pedido || x).find((x) => String(x.numero) === String(alvo.numero));\nif (!p) return [{ json: { ...alvo, tiny_id: null, erro: 'Pedido ' + alvo.numero + ' não encontrado no Tiny: ' + JSON.stringify(ret.erros ?? ret.codigo_erro ?? ret.status ?? $input.first().json?.error ?? 'sem retorno').slice(0, 300) } }];\nreturn [{ json: { ...alvo, tiny_id: String(p.id) } }];"
      }
    },
