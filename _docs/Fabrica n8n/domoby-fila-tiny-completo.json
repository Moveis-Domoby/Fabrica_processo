    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// SESSAO-33: devolve ao banco a resposta CRUA de cada chamada — quem entende é\n// o banco (fn_tiny_fila_resposta: erro, página vazia, limite, próxima página,\n// detalhe de cada registro, gravação). Uma chamada de RPC por linha da fila.\n// NÃO renomear o node \"Montar requisicao Tiny\" — a referência é pelo nome.\nconst saida = [];\nconst itens = $input.all();\nfor (let i = 0; i < itens.length; i++) {\n  const req = $('Montar requisicao Tiny').itemMatching(i).json;\n  const resp = itens[i].json || {};\n  const resposta = req.api === 'v3'\n    ? { api: 'v3', status: resp.status ?? 0, corpo: resp.corpo ?? null, erro: resp.erro ?? (resp.error ? String(resp.error.message || resp.error) : null) }\n    : { api: 'v2', corpo: resp };\n  saida.push({ json: { rpc: 'fn_tiny_fila_resposta', body: { p_fila_id: req.fila_id, p_resposta: resposta } } });\n}\nreturn saida;"
      },
