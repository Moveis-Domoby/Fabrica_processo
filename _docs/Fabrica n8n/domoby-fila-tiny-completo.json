      "id": "16c3d772-af28-5c81-aa91-8542fbf22379",
      "name": "Fila · reservar lote",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        300
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// A RPC devolve a lista das linhas reservadas (já com a chamada montada pelo\n// banco). Dependendo da versão, o node HTTP entrega como 1 item com array,\n// como array solto, ou já dividido em itens: aqui os três viram 1 item por linha.\n// Lote vazio -> [] e o resto do fluxo simplesmente não roda.\nconst linhas = [];\nfor (const it of $input.all()) {\n  const j = it.json;\n  if (Array.isArray(j))            linhas.push(...j);\n  else if (Array.isArray(j.data))  linhas.push(...j.data);\n  else if (j && j.id && j.recurso) linhas.push(j);\n}\nreturn linhas.map((l) => ({ json: l }));"
      },
      "id": "4c64e4a2-a5c5-5254-8bfd-4facfd92749d",
      "name": "Normalizar lote",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        300
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// SESSAO-33: o BANCO já disse o que pedir para cada linha (fn_tiny_fila_lote:\n// conta, api, url ou caminho, campos). Aqui só vira o corpo da chamada.\n// O token NÃO entra aqui (P4): na API v2 quem junta o token DA CONTA da linha\n// é a expressão do node \"Tiny · API v2\", na hora do envio; na API nova (v3) o\n// token nem passa pelo n8n — a ponte tiny-v3 lê no banco.\n// NÃO renomear este node: \"Interpretar resposta\" o procura pelo nome.\nconst enc = (o) => Object.entries(o || {})\n  .filter(([, v]) => v !== undefined && v !== null)\n  .map(([k, v]) => encodeURIComponent(k) + '=' + encodeURIComponent(String(v)))\n  .join('&');\n\nconst saida = [];\nfor (const it of $input.all()) {\n  const j = it.json;\n  if (!j || !j.id) continue;\n  if (j.api === 'v3') {\n    saida.push({ json: {\n      fila_id: j.id, api: 'v3', conta: j.conta, recurso: j.recurso, chave: j.chave,\n      ponte: { conta: j.conta, caminho: j.caminho, consulta: j.campos || {} },\n    } });\n  } else {\n    saida.push({ json: {\n      fila_id: j.id, api: 'v2', conta: j.conta, recurso: j.recurso, chave: j.chave,\n      url: j.url, corpo: enc(j.campos),\n    } });\n  }\n}\nreturn saida;"
      },
