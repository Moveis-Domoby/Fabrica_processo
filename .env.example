# =============================================================================
# Variáveis de ambiente da Plataforma de Produção Domoby
#
# Copie este arquivo para `.env.local` e preencha com os valores reais.
# `.env.local` NUNCA é versionado (está no .gitignore) e os valores NUNCA
# aparecem em chat, print ou nota — regra crítica 4 da casa.
#
# Onde achar: Supabase → seu projeto → Settings → API
# =============================================================================

# URL do projeto (Project URL) — ex.: https://abcdefghijklm.supabase.co
SUPABASE_URL=

# Chave de SERVIÇO (service_role). Ignora RLS: só em script local e servidor,
# NUNCA no código do front.
SUPABASE_SERVICE_ROLE_KEY=

# Chave pública (anon/publishable) — esta sim vai para o front, na SESSAO-03.
SUPABASE_ANON_KEY=

# --- Front (Vite só expõe ao navegador o que começa com VITE_) -------------
# Mesmos valores de SUPABASE_URL e SUPABASE_ANON_KEY, repetidos com o prefixo.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Senha padrão de criação de usuário (D-21). O MESMO valor precisa existir como
# segredo PLT_SENHA_PADRAO nas Edge Functions (Supabase → Edge Functions →
# Secrets). Aqui ela é usada só pelo script de bootstrap do primeiro admin.
PLT_SENHA_PADRAO=

# String de conexão direta do Postgres (Settings → Database → Connection string),
# usada só para aplicar migrations pelo terminal.
#
# Cole a senha EXATAMENTE como ela é, sem escapar nada. O script
# supabase/aplicar-migrations.mjs fatia a string à mão justamente porque a
# senha pode conter caractere com significado em URL — um "#", por exemplo,
# começa o fragmento e faria o resto da string sumir silenciosamente.
SUPABASE_DB_URL=
